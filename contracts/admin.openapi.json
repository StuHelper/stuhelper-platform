                "schema": {
                  "$ref": "#/components/schemas/AdminError"
                }
              }
            }
          },
          "404": {
            "description": "角色不存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminError"
                }
              }
            }
          },
          "409": {
            "description": "授权修订号、角色定义或幂等请求冲突",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminError"
                }
              }
            }
          },
          "503": {
            "description": "身份或数据库不可用",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminError"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdminRoleInput"
              }
            }
          }
        }
      }
    },
    "/api/v1/platform/admin/roles/{role}": {
      "get": {
        "operationId": "getAdminRole",
        "description": "读取不可变角色定义，需要全局 platform.authorization.read 能力。",
        "security": [
          {
            "session": []
          }
        ],
        "parameters": [
          {
            "name": "role",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[a-z][a-z0-9._-]*$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminRole"
                }
              }
            }
          },
          "400": {
            "description": "参数错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminError"
                }
              }
            }
          },
          "401": {
            "description": "未登录",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminError"
                }
              }
            }
          },
          "403": {
            "description": "能力或范围不足",
            "content": {
