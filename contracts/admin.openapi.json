    "/api/v1/platform/admin/administrators/{subject}/grants": {
      "put": {
        "operationId": "grantAdminRole",
        "description": "可信平台管理员可授予任意能力及任意范围，包含敏感能力；普通管理员只能委托自己持有的能力与范围，不能授予 platform.* 能力。禁止任何人给自己增加授权。授权修订号冲突返回 409。每个管理员最多 1000 条有效授权。重复请求重新授权后返回原结果。",
        "security": [
          {
            "session": []
          }
        ],
        "parameters": [
          {
            "name": "subject",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 2048,
              "description": "account.Principal.Key() 编码的 issuer 与 subject。"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
