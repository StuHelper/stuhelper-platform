                }
              }
            }
          },
          "403": {
            "description": "能力或范围不足",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminError"
                }
              }
            }
          },
          "404": {
            "description": "角色不存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminError"
                }
              }
            }
          },
          "409": {
            "description": "授权修订号、角色定义或幂等请求冲突",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminError"
                }
              }
            }
          },
          "503": {
            "description": "身份或数据库不可用",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminError"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdminMutation"
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "revokeAdminRole",
        "description": "能力与三个范围维度分别检查。禁止给自己增加授权；只有可信平台管理员可授予 platform.* 能力。授权修订号冲突返回 409。每个管理员最多 1000 条有效授权。重复请求在重新授权后返回原结果。",
        "security": [
          {
            "session": []
          }
        ],
        "parameters": [
          {
            "name": "subject",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 2048,
              "description": "account.Principal.Key() 编码的 issuer 与 subject。"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminRevision"
                }
              }
            }
          },
          "400": {
            "description": "参数错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminError"
                }
              }
            }
          },
          "401": {
            "description": "未登录",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminError"
                }
              }
            }
          },
          "403": {
            "description": "能力或范围不足",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminError"
                }
              }
            }
          },
          "404": {
            "description": "角色不存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminError"
                }
              }
            }
          },
          "409": {
            "description": "授权修订号、角色定义或幂等请求冲突",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminError"
                }
              }
            }
          },
          "503": {
            "description": "身份或数据库不可用",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminError"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdminMutation"
              }
            }
          }
        }
      }
    },
    "/api/v1/platform/admin/administrators/{subject}/effective": {
      "get": {
        "operationId": "getAdminEffective",
        "description": "返回查询范围内的显式授权；角色包含查询范围时将范围收窄。查询他人需要该范围的 platform.authorization.read。修订号属于整个管理员授权集合。可信平台管理员的管理权由身份接口单独提供，不伪造为角色。",
        "security": [
          {
            "session": []
          }
        ],
        "parameters": [
          {
            "name": "subject",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 2048,
              "description": "account.Principal.Key() 编码的 issuer 与 subject。"
            }
          },
          {
            "name": "school",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "*",
              "maxLength": 128
            }
          },
          {
            "name": "group",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "*",
              "maxLength": 128
            }
          },
          {
            "name": "module",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "*",
              "maxLength": 128
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminEffective"
                }
              }
            }
          },
          "400": {
            "description": "参数错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminError"
                }
              }
            }
          },
          "401": {
            "description": "未登录",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminError"
                }
              }
            }
          },
          "403": {
            "description": "能力或范围不足",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminError"
                }
              }
            }
          },
          "404": {
            "description": "角色不存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminError"
                }
              }
            }
          },
          "409": {
            "description": "授权修订号、角色定义或幂等请求冲突",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminError"
                }
              }
            }
          },
          "503": {
            "description": "身份或数据库不可用",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/platform/admin/operations": {
      "get": {
        "operationId": "listPlatformOperations",
        "description": "仅包含 platform 记录：授权变更、资格配置、安装记录及角色定义。按 ID 降序，时间区间 [from, until)，游标绑定筛选条件。必须具有查询范围的 platform.audit.read；历史无范围记录仅全局可见。原因为空表示旧记录未采集，result 为已提交成功。",
        "security": [
          {
            "session": []
          }
        ],
        "parameters": [
          {
            "name": "school",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "*",
              "maxLength": 128
            }
          },
          {
            "name": "group",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "*",
              "maxLength": 128
            }
          },
          {
            "name": "module",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "*",
              "maxLength": 128
            }
          },
          {
            "name": "target",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 2048
            }
          },
          {
            "name": "actor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 2048
            }
          },
          {
            "name": "action",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 128
            }
          },
          {
            "name": "from",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "until",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 2048
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminAuditPage"
                }
              }
            }
          },
          "400": {
            "description": "参数错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminError"
                }
              }
            }
          },
          "401": {
            "description": "未登录",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminError"
                }
              }
            }
          },
          "403": {
            "description": "能力或范围不足",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminError"
                }
              }
            }
          },
          "404": {
            "description": "角色不存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminError"
                }
              }
            }
          },
          "409": {
            "description": "授权修订号、角色定义或幂等请求冲突",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminError"
                }
              }
            }
          },
          "503": {
            "description": "身份或数据库不可用",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "stuhelper_session"
      }
    },
    "schemas": {
      "AdminScope": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "school": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "精确标识或 *；三个维度同时满足，不根据群推导学校。"
          },
          "group": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "精确标识或 *；三个维度同时满足，不根据群推导学校。"
          },
          "module": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "精确标识或 *；三个维度同时满足，不根据群推导学校。"
          }
        },
        "required": [
          "school",
          "group",
          "module"
        ]
      },
      "AdminRole": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9._-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[a-z][a-z0-9._-]*$"
            },
            "minItems": 1,
            "maxItems": 64,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "name",
          "capabilities"
        ]
      },
      "AdminRoleInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "role": {
            "$ref": "#/components/schemas/AdminRole"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "required": [
          "role",
          "reason"
        ]
      },
      "AdminGrant": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "role": {
            "$ref": "#/components/schemas/AdminRole"
          },
          "scope": {
            "$ref": "#/components/schemas/AdminScope"
          }
        },
        "required": [
          "role",
          "scope"
        ]
      },
      "AdminEffective": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "subject": {
            "type": "string"
          },
          "revision": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "grants": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AdminGrant"
            }
          }
        },
        "required": [
          "subject",
          "revision",
          "grants"
        ]
      },
      "AdminMutation": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "role_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9._-]*$"
          },
          "scope": {
            "$ref": "#/components/schemas/AdminScope"
          },
          "expected_revision": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "required": [
          "role_id",
          "scope",
          "expected_revision",
          "reason"
        ]
      },
      "AdminRevision": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "revision": {
            "type": "string"
          }
        },
        "required": [
          "revision"
        ]
      },
      "AdminAudit": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "enum": [
              "platform"
            ]
          },
          "actor": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "scope": {
            "$ref": "#/components/schemas/AdminScope"
          },
          "reason": {
            "type": "string"
          },
          "result": {
            "type": "string",
            "enum": [
              "success"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "role_id": {
            "type": "string",
            "description": "角色授予或撤销时的角色 ID。"
          },
          "revision": {
            "type": "string",
            "description": "授权变更后的修订号。"
          }
        },
        "required": [
          "id",
          "source",
          "actor",
          "action",
          "target",
          "scope",
          "reason",
          "result",
          "created_at"
        ]
      },
      "AdminAuditPage": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source": {
            "type": "string",
            "enum": [
              "platform"
            ],
            "description": "仅包含 platform 记录，不包含其他业务模块审计。"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AdminAudit"
            },
            "maxItems": 100
          },
          "next_cursor": {
            "type": "string"
          }
        },
        "required": [
          "source",
          "items",
          "next_cursor"
        ]
      },
      "AdminError": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "invalid_request",
              "unauthenticated",
              "forbidden",
              "conflict",
              "not_found",
              "unavailable"
            ]
          }
        },
        "required": [
          "code"
        ]
      }
    }
  }
}
