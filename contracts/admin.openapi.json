{
  "openapi": "3.0.3",
  "info": {
    "title": "StuHelper platform administration",
    "version": "0.1.0",
    "description": "仅包含 platform 记录。公开 Go 授权接口 admin.Service.Evaluate 接收可信 account.Principal、能力和 AdminScope，逐次检查当前身份及持久化授权。HTTP 不接受平台管理员标志。"
  },
  "paths": {
    "/api/v1/platform/admin/role-templates": {
      "get": {
        "operationId": "listAdminRoleTemplates",
        "description": "六种初始模板仅提供建议能力；不自动授权，不包含敏感能力。",
        "security": [
          {
            "session": []
          }
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AdminRole"
                  }
                }
              }
            }
          },
          "400": {
            "description": "参数错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminError"
                }
              }
            }
          },
          "401": {
            "description": "未登录",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminError"
                }
              }
            }
          },
          "403": {
            "description": "能力或范围不足",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminError"
                }
              }
            }
          },
          "404": {
            "description": "角色不存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminError"
                }
              }
            }
          },
          "409": {
            "description": "授权修订号、角色定义或幂等请求冲突",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminError"
                }
              }
            }
          },
          "503": {
            "description": "身份或数据库不可用",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/platform/admin/roles": {
      "post": {
        "operationId": "createAdminRole",
        "description": "只有可信平台管理员可以创建不可变角色定义。变更能力须使用新的角色 ID；角色数量上限 1000。",
        "security": [
          {
            "session": []
          }
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        ],
        "responses": {
          "200": {
