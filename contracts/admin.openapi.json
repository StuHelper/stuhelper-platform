    },
    "/api/v1/platform/admin/administrators/{subject}/effective": {
      "get": {
        "operationId": "getAdminEffective",
        "description": "先检查查询者权限，再从可信身份接口读取被查询者的当前平台管理员身份。平台管理员返回 authorization_mode=platform_admin_all，表示全部能力及全部范围（含敏感能力）；其他管理员返回 explicit_grants 及查询范围内显式授权。查询他人需要该范围的 platform.authorization.read。修订号仅表示显式授权集合，不代表身份修订，客户端不能据此缓存平台管理员身份。",
        "security": [
          {
            "session": []
          }
        ],
        "parameters": [
          {
            "name": "subject",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 2048,
              "description": "account.Principal.Key() 编码的 issuer 与 subject。"
            }
          },
          {
            "name": "school",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "*",
              "maxLength": 128
            }
          },
          {
            "name": "group",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "*",
              "maxLength": 128
            }
          },
          {
            "name": "module",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "*",
              "maxLength": 128
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminEffective"
                }
              }
            }
          },
          "400": {
            "description": "参数错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminError"
                }
              }
            }
          },
          "401": {
            "description": "未登录",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminError"
                }
              }
            }
          },
          "403": {
            "description": "能力或范围不足",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminError"
                }
              }
            }
          },
          "404": {
            "description": "角色不存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminError"
                }
              }
            }
          },
          "409": {
            "description": "授权修订号、角色定义或幂等请求冲突",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminError"
                }
              }
            }
          },
          "503": {
            "description": "身份或数据库不可用",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/platform/admin/operations": {
      "get": {
        "operationId": "listPlatformOperations",
        "description": "按当前有效授权范围向已装配提供方读取并合并审计，时间、来源模块、记录 ID 均按降序排序。每页重新授权；游标绑定操作者、筛选条件、权限范围和提供方集合，并保留各提供方的快照。提供方失败返回部分结果及 missing_modules；缺失在同一分页过程中持续标记，恢复后须重新查询。默认查询全部已装配且获准的来源。旧版本游标不接受。",
        "security": [
          {
            "session": []
          }
        ],
        "parameters": [
          {
            "name": "school",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "*",
              "maxLength": 128
            }
          },
          {
            "name": "group",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "*",
              "maxLength": 128
            }
          },
          {
            "name": "module",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "*",
              "maxLength": 128
            }
          },
          {
            "name": "target",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 2048
            }
          },
          {
            "name": "actor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 2048
            }
          },
          {
            "name": "action",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 128
            }
          },
          {
            "name": "from",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "until",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 16384
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          },
          {
            "name": "sources",
            "in": "query",
            "required": false,
            "style": "form",
            "explode": false,
            "schema": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              }
            },
            "description": "按原始审计所属模块筛选，逗号分隔；与 module（对象授权范围）分别检查。未装配或不在注册清单的模块返回 400。"
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminAuditPage"
                }
              }
            }
          },
          "400": {
            "description": "参数错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminError"
                }
              }
            }
          },
          "401": {
            "description": "未登录",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminError"
                }
              }
            }
          },
          "403": {
            "description": "能力或范围不足",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminError"
                }
              }
            }
          },
          "404": {
            "description": "角色不存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminError"
                }
              }
            }
          },
          "409": {
            "description": "授权修订号、角色定义或幂等请求冲突",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminError"
                }
              }
            }
          },
          "503": {
            "description": "身份或数据库不可用",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "stuhelper_session"
      }
    },
    "schemas": {
      "AdminScope": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "school": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "精确标识或 *；三个维度同时满足，不根据群推导学校。"
          },
          "group": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "精确标识或 *；三个维度同时满足，不根据群推导学校。"
          },
          "module": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "精确标识或 *；三个维度同时满足，不根据群推导学校。"
          }
        },
        "required": [
          "school",
          "group",
          "module"
        ]
      },
      "AdminRole": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9._-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[a-z][a-z0-9._-]*$"
            },
            "minItems": 1,
            "maxItems": 64,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "name",
          "capabilities"
        ]
      },
      "AdminRoleInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "role": {
            "$ref": "#/components/schemas/AdminRole"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "required": [
          "role",
          "reason"
        ]
      },
      "AdminGrant": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "role": {
            "$ref": "#/components/schemas/AdminRole"
          },
          "scope": {
            "$ref": "#/components/schemas/AdminScope"
          }
        },
        "required": [
          "role",
          "scope"
        ]
      },
      "AdminEffective": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "subject": {
            "type": "string"
          },
          "revision": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "grants": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AdminGrant"
            },
            "description": "查询范围内的显式授权记录；平台管理员的全部能力由 authorization_mode 表示，不创建虚假角色授权。"
          },
          "authorization_mode": {
            "type": "string",
            "enum": [
              "platform_admin_all",
              "explicit_grants"
            ],
            "description": "platform_admin_all 表示被查询者是可信平台管理员，自动拥有任意能力及任意范围（含敏感能力）；explicit_grants 表示按 grants 显式授权。不得用 grants 是否为空判断平台管理员权限。"
          }
        },
        "required": [
          "subject",
          "revision",
          "grants",
          "authorization_mode"
        ]
      },
      "AdminMutation": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "role_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9._-]*$"
          },
          "scope": {
            "$ref": "#/components/schemas/AdminScope"
          },
          "expected_revision": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "required": [
          "role_id",
          "scope",
          "expected_revision",
          "reason"
        ]
      },
      "AdminRevision": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "revision": {
            "type": "string"
          }
        },
        "required": [
          "revision"
        ]
      },
      "AdminAudit": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "description": "原始审计所属业务模块标识。"
          },
          "actor": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "scope": {
            "$ref": "#/components/schemas/AdminScope"
          },
          "reason": {
            "type": "string",
            "description": "脱敏原因或原因码；原始记录未采集时为空。"
          },
          "result": {
            "type": "string",
            "description": "success、denied、failed 或 unknown；不能从缺失字段推测成功。"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "role_id": {
            "type": "string",
            "description": "角色授予或撤销时的角色 ID。"
          },
          "revision": {
            "type": "string",
            "description": "授权变更后的修订号。"
          }
        },
        "required": [
          "id",
          "source",
          "actor",
          "action",
          "target",
          "scope",
          "reason",
          "result",
          "created_at"
        ]
      },
      "AdminAuditPage": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source": {
            "type": "string",
            "enum": [
              "platform"
            ],
            "description": "汇总查询由 platform 提供，单条记录 source 标识原始模块。"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AdminAudit"
            },
            "maxItems": 100
          },
          "next_cursor": {
            "type": "string"
          },
          "partial": {
            "type": "boolean",
            "description": "当前分页过程存在提供方缺失。"
          },
          "missing_modules": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 16
          },
          "queried_modules": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 16,
            "description": "当前有效授权允许查询的已装配模块。"
          }
        },
        "required": [
          "source",
          "items",
          "next_cursor",
          "partial",
          "missing_modules",
          "queried_modules"
        ]
      },
      "AdminError": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "invalid_request",
              "unauthenticated",
              "forbidden",
              "conflict",
              "not_found",
              "unavailable"
            ]
          }
        },
        "required": [
          "code"
        ]
      }
    }
  }
}
