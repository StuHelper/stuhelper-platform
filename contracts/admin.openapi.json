                  "$ref": "#/components/schemas/AdminError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/platform/admin/administrators/{subject}/grants": {
      "put": {
        "operationId": "grantAdminRole",
        "description": "能力与三个范围维度分别检查。禁止给自己增加授权；只有可信平台管理员可授予 platform.* 能力。授权修订号冲突返回 409。每个管理员最多 1000 条有效授权。重复请求在重新授权后返回原结果。",
        "security": [
          {
            "session": []
          }
        ],
        "parameters": [
          {
            "name": "subject",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 2048,
              "description": "account.Principal.Key() 编码的 issuer 与 subject。"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminRevision"
                }
              }
            }
          },
          "400": {
            "description": "参数错误",
